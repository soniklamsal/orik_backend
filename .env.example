# Copy to .env and fill in. .env is git-ignored.

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kathmandu

# Browser origins allowed to POST enquiries. Add the live domain before launch.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Submissions allowed per IP, e.g. 5/hour, 20/day.
ENQUIRY_RATE_LIMIT=5/hour

# Leave POSTGRES_DB empty to use the local SQLite file.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
